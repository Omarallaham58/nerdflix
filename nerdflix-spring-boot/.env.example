# Copy to .env (never commit it) and fill in your own values.
# Load it before running, e.g. with the EnvFile plugin in IntelliJ or `set -a; . ./.env; set +a` in a shell.

DB_URL=jdbc:postgresql://localhost:5432/ilog
DB_USERNAME=postgres
DB_PASSWORD=

# Backblaze B2 application key with read/write access to the bucket
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=

# 32 hex characters, e.g. generated with: openssl rand -hex 16
VIDEO_ENCRYPTION_KEY=

# At least 32 random bytes, e.g. generated with: openssl rand -base64 48
JWT_SECRET=

# Must match WORKER_TOKEN_SECRET in local-worker/.dev.vars
WORKER_BASE_URL=http://localhost:8787
WORKER_TOKEN_SECRET=
